# /home/sysai/.config/overlord/env  (owner sysai, mode 600)
# Read by the runner (bash) and by overlord-web.service (systemd), so keep to
# plain KEY=value lines: no "export", no spaces around "=", single quotes if a
# value has spaces or special characters.

# Claude Console API key named "overlord" (own workspace, monthly spend limit)
ANTHROPIC_API_KEY=

# status site login (http://10.0.0.33:8090/)
OVERLORD_WEB_USER=
OVERLORD_WEB_PASS=

# report email, from and to
OVERLORD_MAIL_TO=jaytcornell@gmail.com
OVERLORD_SITE_URL=http://10.0.0.33:8090/

# optional: pin a model (alias or full name); default is Claude Code's default
#OVERLORD_MODEL=sonnet
